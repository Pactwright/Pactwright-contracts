# Pactwright pubnet deployment. Only after the audit (ROADMAP P8-03).
# scripts/deploy.sh refuses to run while any input below is empty, and also requires
# PACTWRIGHT_CONFIRM_PUBNET=yes in the environment.

# ---- inputs ----
NETWORK=mainnet
SOURCE=
ANCHORER=
USDC_SAC_ID=
VERIFIER_PUBLIC_KEY=
MAX_PACT_LEDGERS=

# ---- outputs (scripts/deploy.sh) ----
PACT_CONTRACT_ID=
PACT_WASM_HASH=
RECEIPT_ANCHOR_ID=
RECEIPT_ANCHOR_WASM_HASH=
